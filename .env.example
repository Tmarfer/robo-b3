# Copiar para .env (fora do git) e `chmod 600 .env`.
# Preencher só o que a fase atual usa.

# MT5 demo na VPS (docker compose --profile mt5)
# senha da tela do MT5 no navegador (noVNC) — defina uma senha forte
MT5_UI_PASSWORD=
# trocar pelo digest fixo depois do 1º teste (docs/mt5.md)
MT5_IMAGE=lprett/mt5linux:latest
# Login automático (opcional). Preferível deixar vazio, entrar pela tela e salvar a senha
# no terminal: assim a senha da conta não fica em arquivo.
MT5_LOGIN=
MT5_SERVER=
MT5_PASSWORD=

# Fase 5 — alertas e IA
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
